#!/usr/bin/env bash
# opencode-workspace
#
# Opens a tmux session with one pane per configured project path,
# each running opencode. Designed to work alongside tmux-sessionizer.
#
# Config: ~/.config/tmux-sessionizer/opencode-workspace.conf
# Usage:  opencode-workspace   (or alias: ow)

SESSION_NAME="opencode-workspace"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-sessionizer"
CONFIG_FILE="$CONFIG_DIR/opencode-workspace.conf"

# ---------------------------------------------------------------------------
# Load config
# ---------------------------------------------------------------------------
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: config file not found at $CONFIG_FILE"
    exit 1
fi

source "$CONFIG_FILE"

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo "Usage: opencode-workspace"
    echo ""
    echo "Opens a tmux session named '$SESSION_NAME' with one pane per project"
    echo "path defined in:"
    echo "  $CONFIG_FILE"
    echo ""
    echo "Edit that file to set up to 4 project paths."
    echo "Each pane will launch opencode in the corresponding directory."
    echo ""
    echo "Pane layouts:"
    echo "  1 path  → single full pane"
    echo "  2 paths → side by side (even-horizontal)"
    echo "  3 paths → main-vertical (1 large left, 2 stacked right)"
    echo "  4 paths → 2×2 tiled grid"
    exit 0
fi

# ---------------------------------------------------------------------------
# Validate
# ---------------------------------------------------------------------------
if ! command -v tmux &>/dev/null; then
    echo "Error: tmux is not installed."
    exit 1
fi

if ! command -v opencode &>/dev/null; then
    echo "Error: opencode is not installed or not in PATH."
    exit 1
fi

# Filter out empty entries
active_paths=()
for p in "${OPENCODE_WORKSPACE_PATHS[@]}"; do
    [[ -n "$p" ]] && active_paths+=("$p")
done

if [[ "${#active_paths[@]}" -eq 0 ]]; then
    echo "Error: no paths configured in $CONFIG_FILE"
    echo "Open the file and uncomment/add up to 4 project paths."
    exit 1
fi

if [[ "${#active_paths[@]}" -gt 4 ]]; then
    echo "Error: too many paths configured (max 4, found ${#active_paths[@]})."
    exit 1
fi

for p in "${active_paths[@]}"; do
    if [[ ! -d "$p" ]]; then
        echo "Error: path does not exist or is not a directory: $p"
        exit 1
    fi
done

# ---------------------------------------------------------------------------
# If the session already exists, attach to it
# ---------------------------------------------------------------------------
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Session '$SESSION_NAME' already exists — attaching."
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "$SESSION_NAME"
    else
        tmux attach-session -t "$SESSION_NAME"
    fi
    exit 0
fi

# ---------------------------------------------------------------------------
# Create the session (always detached — safe inside or outside tmux)
# ---------------------------------------------------------------------------
first="${active_paths[0]}"
# new-session -d never nests; it creates the session in the background
# regardless of whether we are currently inside another tmux session.
tmux new-session -d -s "$SESSION_NAME" -c "$first"

# Capture the stable pane ID of the first pane (e.g. %42).
# We always use pane IDs (not index numbers) for send-keys and split-window
# targets because tmux renumbers indices whenever a new pane is inserted,
# which would cause opencode to be sent to the wrong pane.
pane1=$(tmux display-message -t "${SESSION_NAME}:1.1" -p "#{pane_id}")
tmux send-keys -t "$pane1" "opencode" Enter

# ---------------------------------------------------------------------------
# Split panes for remaining paths — capture each new pane's stable ID.
# All split-window calls target the new session explicitly so they never
# affect the caller's current session when running from inside tmux.
# ---------------------------------------------------------------------------
count="${#active_paths[@]}"

if [[ "$count" -ge 2 ]]; then
    # Split pane1 horizontally → new pane appears to the right
    pane2=$(tmux split-window -t "$pane1" -h -c "${active_paths[1]}" -P -F "#{pane_id}")
    tmux send-keys -t "$pane2" "opencode" Enter
fi

if [[ "$count" -ge 3 ]]; then
    # Split pane2 vertically → new pane appears below pane2 (bottom-right)
    pane3=$(tmux split-window -t "$pane2" -v -c "${active_paths[2]}" -P -F "#{pane_id}")
    tmux send-keys -t "$pane3" "opencode" Enter
fi

if [[ "$count" -eq 4 ]]; then
    # Split pane1 vertically → new pane appears below pane1 (bottom-left)
    pane4=$(tmux split-window -t "$pane1" -v -c "${active_paths[3]}" -P -F "#{pane_id}")
    tmux send-keys -t "$pane4" "opencode" Enter
fi

# ---------------------------------------------------------------------------
# Apply layout
# ---------------------------------------------------------------------------
case "$count" in
    1) # no layout needed
        ;;
    2)
        tmux select-layout -t "${SESSION_NAME}:1" even-horizontal
        ;;
    3)
        tmux select-layout -t "${SESSION_NAME}:1" main-vertical
        ;;
    4)
        tmux select-layout -t "${SESSION_NAME}:1" tiled
        ;;
esac

# Focus pane 1
tmux select-pane -t "$pane1"

# ---------------------------------------------------------------------------
# Switch to the new session — never nests:
#   • inside tmux  → switch-client moves the current client to the new session
#   • outside tmux → attach-session connects normally
# ---------------------------------------------------------------------------
if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$SESSION_NAME"
else
    tmux attach-session -t "$SESSION_NAME"
fi
